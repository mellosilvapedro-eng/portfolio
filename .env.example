# OpenRouter API key for the portfolio AI agent (/api/chat).
# One key routes to many model providers — get one at https://openrouter.ai/keys
# Copy this file to .env.local and fill in your key.
OPENROUTER_API_KEY=

# Optional. Comma-separated model preference list (failover, first to produce
# output wins). Defaults to "anthropic/claude-sonnet-4.6,google/gemini-2.0-flash-001".
# Browse slugs at https://openrouter.ai/models
OPENROUTER_MODEL=
